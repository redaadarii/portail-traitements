# Copier ce fichier en .env.local et le compléter (.env.local n'est jamais commité)

# URL du workspace, sans "/" final
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com

# Dev local : token personnel Databricks (Settings > Developer > Access tokens)
DATABRICKS_TOKEN=

# ID du job import_budget (databricks jobs list)
DATABRICKS_JOB_ID=

# Volume où déposer les fichiers
VOLUME_PATH=/Volumes/workspace/portail/fichiers
